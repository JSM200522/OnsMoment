<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Android 13+ runtime-permission voor system-tray notificaties.
         Wordt via firebase_messaging.requestPermission() aangevraagd zodra
         de gebruiker succesvol is ingelogd (Fase 1 push-meldingen). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Fase VB-V0 videobellen: camera-toegang voor de LiveKit-verbinding
         (runtime-permission wordt in V1 via permission_handler aan-
         gevraagd bij de eerste bel). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Vereist door flutter_webrtc voor audio-routing (speaker/oor-
         schelp, bluetooth-headset) tijdens een gesprek. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <!-- Fase VB-V5: laat een inkomend gesprek het scherm wakker maken
         en over het lock-screen tonen. Android 14+ vraagt hiervoor een
         extra runtime-check die V5 zal toevoegen. Ons Moment kwalificeert
         als 'calling app' zodat het gebruik gerechtvaardigd is. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- K-3: auto-herstart naar vergrendelde rustige modus na reboot/stroomuitval.
         Vereist op Samsung/Xiaomi dat de gebruiker de app handmatig toevoegt
         aan de fabrikant-specifieke autostart-lijst. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
        android:label="Ons Moment"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- FCM fallback-channel: wanneer een payload geen expliciete
             channel_id meegeeft, komen meldingen op ons_moment_twinkel
             binnen (twinkel is ook de codebase-default voor kring.
             herkenningsgeluid). De 6 per-geluid channels worden door
             PushService bij eerste app-open aangemaakt; de Cloud Function
             (Fase 3) zet notification.android.channel_id per bericht op
             basis van kring.herkenningsgeluid via PushService.
             channelIdVoorGeluid. -->
        <!-- K-3: BOOT_COMPLETED receiver voor auto-herstart vergrendelde rustige
             modus na reboot/stroomuitval. Android 10+: start via fullScreenIntent-
             notificatie (directe Activity-start vanuit BroadcastReceiver verboden). -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="ons_moment_twinkel"/>
        <!-- FCM statusbar-icon (Fase 2a): monochroom wit-op-transparant
             silhouet van de spraakballon met hart. Android tint automatisch
             met de default_notification_color. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_ons_moment"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/ons_moment_peach"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility?hl=en and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
